<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permiso especial: se da UNA vez por adb (`pm grant`). Lo usa solo el interruptor del protector, para escribir `screensaver_components`. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- Para poder ver el nombre de otros protectores instalados. -->
    <queries>
        <intent>
            <action android:name="android.service.dreams.DreamService" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icono"
        android:label="@string/app_name"
        android:theme="@style/Theme.MuseumSlideshow">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El protector de pantalla. El nombre de esta clase es identidad fija (ver CLAUDE.md). -->
        <service
            android:name=".protector.ProtectorMuseo"
            android:exported="true"
            android:icon="@drawable/icono"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/protector" />
        </service>
    </application>
</manifest>
